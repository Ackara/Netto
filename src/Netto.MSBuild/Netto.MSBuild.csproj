<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		
		<Version>0.0.5</Version>
		<AssemblyVersion>0.0.5</AssemblyVersion>
		<AssemblyFileVersion>0.0.5</AssemblyFileVersion>
	</PropertyGroup>

	<PropertyGroup>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>

		<Deterministic>true</Deterministic>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
	</PropertyGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Netto\Netto.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.403">
	    <PrivateAssets>all</PrivateAssets>
	    <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	  </PackageReference>
	</ItemGroup>

	<ItemGroup Label="Package">
		<Content Include="../../$(PackageIcon)" PackagePath="" Visible="false" />
		<Content Include="../../$(PackageReadmeFile)" PackagePath="" Visible="false" />
		<Content Include="../../$(PackageLicenseFile)" PackagePath="" Visible="false" />
	</ItemGroup>
</Project>
